PORT=5000
NODE_ENV=production

# Supabase
SUPABASE_URL=https://tlkuulvmahjcrsaioylt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ON_VPS_WITH_SUPABASE_SERVICE_ROLE_KEY
# JWT
JWT_SECRET=REPLACE_ON_VPS_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=7d

# CORS
FRONTEND_URL=https://cutnculturesalon.cloud

# Salon
SALON_NAME=Cut n Culture
SALON_ADDRESS=Plot no. 20 Next Step Physio Opposite The Valencia building moti nagar akshardham mandir road, Chitrkoot, Vaishali Nagar, Jaipur, Rajasthan 302021
SALON_PHONE=9358830044

# Admin seed
ADMIN_EMAIL=REPLACE_ON_VPS_WITH_ADMIN_EMAIL
ADMIN_PASSWORD=REPLACE_ON_VPS_WITH_STRONG_ADMIN_PASSWORD
ADMIN_NAME=Salon Admin

# WhatsApp
WHATSAPP_SESSION_PATH=/var/www/salon-crm/backend/.wwebjs_auth
CRON_TIMEZONE=Asia/Kolkata
AUTO_INIT_WHATSAPP=false
WHATSAPP_RECONNECT_DELAY_MS=30000

# Puppeteer — uses system Chrome installed on VPS
PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
PUPPETEER_CACHE_DIR=/root/.cache/puppeteer

DATABASE_URL=REPLACE_ON_VPS_WITH_DATABASE_URL
